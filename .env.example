# ==============================================================================
# Sinaaty — root .env.example
# Copy to `.env` (never commit `.env`). apps/api/.env.example (Step 1) mirrors
# the API section; keep both in sync with CLAUDE.md §7.
# Values below match infra/docker/docker-compose.yml for local dev.
# ==============================================================================

NODE_ENV=development
APP_ENV=dev
PORT=3000
API_BASE_URL=http://localhost:3000
ADMIN_WEB_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001,http://localhost:8080

# ---- Postgres 16 + PostGIS ---------------------------------------------------
DATABASE_URL=postgresql://sinaaty:sinaaty@localhost:5432/sinaaty?schema=public
# Direct URL for prisma migrate (no pooler)
DIRECT_DATABASE_URL=postgresql://sinaaty:sinaaty@localhost:5432/sinaaty?schema=public

# ---- Redis 7 (cache, rate-limit, BullMQ, Socket.IO adapter) ------------------
REDIS_URL=redis://localhost:6379

# ---- Object storage (MinIO locally, S3-compatible in-KSA in prod) ------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=me-central-1
S3_BUCKET_MEDIA=sinaaty-media
S3_BUCKET_DOCS=sinaaty-docs
S3_KEY=sinaaty
S3_SECRET=sinaaty-secret
S3_FORCE_PATH_STYLE=true

# ---- Meilisearch -------------------------------------------------------------
MEILI_HOST=http://localhost:7700
MEILI_KEY=sinaaty-meili-master-key

# ---- Mail (Mailpit locally) --------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@sinaaty.local

# ---- Auth / crypto -----------------------------------------------------------
# RS256 key pair, PEM, newlines escaped as \n  (generate: openssl genrsa 2048)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# 32 bytes base64 (generate: openssl rand -base64 32) — AES-256-GCM for national_id / iban / CSIDs
PII_ENC_KEY=

# ---- Integrations (Anti-Corruption Layer) — mock|live, default mock ---------
INTEGRATION_NAFATH=mock
NAFATH_APP_ID=
NAFATH_APP_KEY=
NAFATH_CALLBACK_URL=http://localhost:3000/v1/auth/nafath/callback

INTEGRATION_NAFEZ=mock
NAFEZ_BASE_URL=
NAFEZ_CLIENT_ID=
NAFEZ_CLIENT_SECRET=

INTEGRATION_ZATCA=mock
ZATCA_BASE_URL=

INTEGRATION_PSP=mock
PSP_PROVIDER=
PSP_API_KEY=
PSP_WEBHOOK_SECRET=

INTEGRATION_ESCROW=mock
ESCROW_PROVIDER=
ESCROW_API_KEY=

INTEGRATION_SMS=mock
SMS_PROVIDER=
SMS_API_KEY=
FCM_SERVICE_ACCOUNT_JSON=

INTEGRATION_AI=mock
ANTHROPIC_API_KEY=
SPEECH_PROVIDER=
MAPS_API_KEY=
VIN_DECODER_KEY=

# ---- Business defaults (overridable in platform_settings) --------------------
ESCROW_AUTO_RELEASE_HOURS=72
BIDDING_DEFAULT_MINUTES=60
ABANDONED_NOTICE_DAYS=15
DEFAULT_VAT_BPS=1500

# ---- Observability -----------------------------------------------------------
LOG_LEVEL=debug
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
