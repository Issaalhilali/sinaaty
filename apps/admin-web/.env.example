# كلاهما يُحقن عند البناء لا عند التشغيل (المتصفح يحتاجهما):
#   ng build --define API_BASE_URL="'https://api.example'" --define PRIMEUI_LICENSE="'<key>'"
# أو في Docker: --build-arg API_BASE_URL=… --build-arg PRIMEUI_LICENSE=…
API_BASE_URL=http://localhost:3000
# مفتاح PrimeUI (Community مجاني لمنشأةٍ صغيرة، أو Commercial) — سرٌّ: يبقى في مخزن أسرار CI، لا هنا ولا في المستودع.
PRIMEUI_LICENSE=
