# apps/api/.env.example — mirrors the API section of the root .env.example (CLAUDE.md §7).
# Copy to apps/api/.env for local dev. Never commit .env.
NODE_ENV=development
APP_ENV=dev
PORT=3000
API_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3001,http://localhost:8080
LOG_LEVEL=debug

DATABASE_URL=postgresql://sinaaty:sinaaty@localhost:5432/sinaaty?schema=public
DIRECT_DATABASE_URL=postgresql://sinaaty:sinaaty@localhost:5432/sinaaty?schema=public
# Supabase instead of local Postgres? Copy .env.supabase (see tools/supabase-db.sh):
#   DATABASE_URL       = Transaction pooler (6543) + ?pgbouncer=true&connection_limit=1&sslmode=require
#   DIRECT_DATABASE_URL= Direct (5432) + ?sslmode=require   ← migrations/seed
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_…   (public; unused by the API)
REDIS_URL=redis://localhost:6379

# 32-byte base64 key for PII encryption (dev only — generate: openssl rand -base64 32)
PII_ENC_KEY=Y7Wq2b3nJ9tR6vX1cD4fH8kL0pS5uZ2wA3eG6iK9mN0=

# ---- Auth (Step 4) — dev keys only; generate your own for staging/prod: pnpm --filter api gen:keys
JWT_PRIVATE_KEY=LS0tLS1CRUdJTiBQUklWQVRFIEtFWS0tLS0tCk1DNENBUUF3QlFZREsyVndCQ0lFSUFIWCt3WHNDWmpaMFVUcU80V1BDZWVqL2duWnVHSytsUjFLeXp3dU5sVTAKLS0tLS1FTkQgUFJJVkFURSBLRVktLS0tLQo=
JWT_PUBLIC_KEY=LS0tLS1CRUdJTiBQVUJMSUMgS0VZLS0tLS0KTUNvd0JRWURLMlZ3QXlFQUdqSVVqR3daMksrVTU0SzVtZEpTdFZsbVBLa1krbUlEMDNhTlB0ODF0d0k9Ci0tLS0tRU5EIFBVQkxJQyBLRVktLS0tLQo=
JWT_ISSUER=sinaaty
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_10MIN=3
NAFATH_MOCK_AUTO_APPROVE_MS=1500
NAFATH_CALLBACK_SECRET=dev-nafath-callback-secret

# Rate limiting (per IP, per window)
# ---- observability (OpenTelemetry) — off by default; staging/prod enable it via Helm values
OTEL_ENABLED=false
OTEL_SERVICE_NAME=sinaaty-api
OTEL_EXPORTER=otlp                 # otlp | console (console prints spans locally)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# Integrations — default mock everywhere in dev/test (CLAUDE.md §5.3)
INTEGRATION_NAFATH=mock
INTEGRATION_NAFEZ=mock
INTEGRATION_ZATCA=mock
INTEGRATION_PSP=mock
INTEGRATION_ESCROW=mock
INTEGRATION_SMS=mock
INTEGRATION_AI=mock
INTEGRATION_STORAGE=mock
INTEGRATION_VIN=mock
PSP_PROVIDER=mock
PSP_WEBHOOK_SECRET=dev-psp-webhook-secret
ESCROW_AUTO_RELEASE_HOURS=72
VAT_RATE_PCT=15
JOBS_ENABLED=true
APPROVAL_LINK_SECRET=dev-approval-link-secret-change-me
WEB_APPROVAL_BASE_URL=http://localhost:3000
S3_BUCKET_MEDIA=sinaaty-media
S3_BUCKET_DOCS=sinaaty-docs

INTEGRATION_MAPS=mock
# منجز/تقدير — accident reports (mock only; provider contract unconfirmed, see docs/integrations/monjez.md)
INTEGRATION_ACCIDENTS=mock
TRANSPORT_MARGIN_BPS=1500
TRANSPORT_TRACK_MIN_SECONDS=10
