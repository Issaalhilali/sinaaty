generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["tracing"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorType   String   @default("user") @map("actor_type") @db.VarChar(20)
  orgId       String?  @map("org_id") @db.Uuid
  action      String   @db.VarChar(80)
  entityType  String   @map("entity_type") @db.VarChar(40)
  entityId    String?  @map("entity_id") @db.Uuid
  before      Json?
  after       Json?
  ipAddress   String?  @map("ip_address") @db.Inet
  userAgent   String?  @map("user_agent")
  requestId   String?  @map("request_id") @db.VarChar(64)
  prevHash    String?  @map("prev_hash") @db.Char(64)
  hash        String   @db.Char(64)

  @@index([actorUserId, occurredAt(sort: Desc)], map: "idx_audit_actor")
  @@index([entityType, entityId, occurredAt], map: "idx_audit_entity")
  @@map("audit_log")
}

model Device {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String               @map("user_id") @db.Uuid
  platform            String               @db.VarChar(20)
  deviceName          String?              @map("device_name") @db.VarChar(120)
  pushToken           String?              @map("push_token")
  appFlavor           String?              @map("app_flavor") @db.VarChar(20)
  appVersion          String?              @map("app_version") @db.VarChar(20)
  lastSeenAt          DateTime?            @map("last_seen_at") @db.Timestamptz(6)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt           DateTime?            @map("revoked_at") @db.Timestamptz(6)
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  refreshTokens       RefreshToken[]
  workOrderSignatures WorkOrderSignature[]

  @@map("devices")
}

model DisputeMessage {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  disputeId    String   @map("dispute_id") @db.Uuid
  authorUserId String   @map("author_user_id") @db.Uuid
  isInternal   Boolean  @default(false) @map("is_internal")
  bodyAr       String   @map("body_ar")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  authorUser   User     @relation(fields: [authorUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dispute      Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("dispute_messages")
}

model Dispute {
  id                         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number                     String              @unique @db.VarChar(24)
  status                     dispute_status      @default(open)
  openedByUserId             String              @map("opened_by_user_id") @db.Uuid
  claimantOrgId              String?             @map("claimant_org_id") @db.Uuid
  respondentOrgId            String?             @map("respondent_org_id") @db.Uuid
  respondentUserId           String?             @map("respondent_user_id") @db.Uuid
  workOrderId                String?             @map("work_order_id") @db.Uuid
  partOrderId                String?             @map("part_order_id") @db.Uuid
  transportJobId             String?             @map("transport_job_id") @db.Uuid
  escrowHoldId               String?             @map("escrow_hold_id") @db.Uuid
  category                   String              @db.VarChar(40)
  descriptionAr              String              @map("description_ar")
  claimedAmount              Decimal?            @map("claimed_amount") @db.Decimal(14, 2)
  resolution                 dispute_resolution?
  resolutionAmountToCustomer Decimal?            @map("resolution_amount_to_customer") @db.Decimal(14, 2)
  resolutionNoteAr           String?             @map("resolution_note_ar")
  assignedTo                 String?             @map("assigned_to") @db.Uuid
  resolvedBy                 String?             @map("resolved_by") @db.Uuid
  resolvedAt                 DateTime?           @map("resolved_at") @db.Timestamptz(6)
  createdAt                  DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)
  disputeMessages            DisputeMessage[]
  assignedToUser             User?               @relation("disputes_assigned_toTousers", fields: [assignedTo], references: [id], onDelete: NoAction, onUpdate: NoAction)
  claimantOrg                Organization?       @relation("disputes_claimant_org_idToorganizations", fields: [claimantOrgId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  escrowHold                 EscrowHold?         @relation("disputes_escrow_hold_idToescrow_holds", fields: [escrowHoldId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  openedByUser               User                @relation("disputes_opened_by_user_idTousers", fields: [openedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  partOrder                  PartOrder?          @relation(fields: [partOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resolvedByUser             User?               @relation("disputes_resolved_byTousers", fields: [resolvedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  respondentOrg              Organization?       @relation("disputes_respondent_org_idToorganizations", fields: [respondentOrgId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  respondentUser             User?               @relation("disputes_respondent_user_idTousers", fields: [respondentUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transportJob               TransportJob?       @relation(fields: [transportJobId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workOrder                  WorkOrder?          @relation(fields: [workOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  escrowHoldsAsDispute       EscrowHold[]        @relation("escrow_holds_dispute_idTodisputes")
  warrantyClaims             WarrantyClaim[]

  @@index([status, createdAt], map: "idx_disputes_status")
  @@map("disputes")
}

model DriverProfile {
  userId           String                    @id @map("user_id") @db.Uuid
  orgId            String?                   @map("org_id") @db.Uuid
  licenseNumberEnc Bytes?                    @map("license_number_enc")
  truckPlate       String?                   @map("truck_plate") @db.VarChar(12)
  truckType        transport_type?           @map("truck_type")
  isOnline         Boolean                   @default(false) @map("is_online")
  lastGeo          Unsupported("geography")? @map("last_geo")
  lastGeoAt        DateTime?                 @map("last_geo_at") @db.Timestamptz(6)
  ratingAvg        Decimal                   @default(0) @map("rating_avg") @db.Decimal(3, 2)
  org              Organization?             @relation(fields: [orgId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user             User                      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("driver_profiles")
}

model DunningNotice {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  noteId       String?              @map("note_id") @db.Uuid
  invoiceId    String?              @map("invoice_id") @db.Uuid
  step         Int                  @db.SmallInt
  channel      notification_channel
  isFormal     Boolean              @default(false) @map("is_formal")
  sentAt       DateTime             @default(now()) @map("sent_at") @db.Timestamptz(6)
  proofMediaId String?              @map("proof_media_id") @db.Uuid
  invoice      Invoice?             @relation(fields: [invoiceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  note         PromissoryNote?      @relation(fields: [noteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  proofMedia   MediaAsset?          @relation(fields: [proofMediaId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("dunning_notices")
}

model EnforcementCase {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  noteId             String             @map("note_id") @db.Uuid
  status             enforcement_status @default(preparing)
  najizCaseRef       String?            @map("najiz_case_ref") @db.VarChar(80)
  requestedBy        String?            @map("requested_by") @db.Uuid
  bundleMediaId      String?            @map("bundle_media_id") @db.Uuid
  claimedAmount      Decimal            @map("claimed_amount") @db.Decimal(14, 2)
  recoveredAmount    Decimal            @default(0) @map("recovered_amount") @db.Decimal(14, 2)
  isAbandonedVehicle Boolean            @default(false) @map("is_abandoned_vehicle")
  storageFeesClaimed Decimal            @default(0) @map("storage_fees_claimed") @db.Decimal(14, 2)
  timeline           Json               @default("[]")
  filedAt            DateTime?          @map("filed_at") @db.Timestamptz(6)
  closedAt           DateTime?          @map("closed_at") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  bundleMedia        MediaAsset?        @relation(fields: [bundleMediaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  note               PromissoryNote     @relation(fields: [noteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requestedByUser    User?              @relation(fields: [requestedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("enforcement_cases")
}

model EscrowHold {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId            String        @map("payment_id") @db.Uuid
  beneficiaryOrgId     String        @map("beneficiary_org_id") @db.Uuid
  workOrderId          String?       @map("work_order_id") @db.Uuid
  partOrderId          String?       @map("part_order_id") @db.Uuid
  amount               Decimal       @db.Decimal(14, 2)
  platformFee          Decimal       @default(0) @map("platform_fee") @db.Decimal(14, 2)
  status               escrow_status @default(pending)
  autoReleaseAt        DateTime?     @map("auto_release_at") @db.Timestamptz(6)
  releasedAmount       Decimal       @default(0) @map("released_amount") @db.Decimal(14, 2)
  refundedAmount       Decimal       @default(0) @map("refunded_amount") @db.Decimal(14, 2)
  releaseReason        String?       @map("release_reason") @db.VarChar(40)
  disputeId            String?       @map("dispute_id") @db.Uuid
  escrowProviderRef    String?       @map("escrow_provider_ref") @db.VarChar(120)
  heldAt               DateTime?     @map("held_at") @db.Timestamptz(6)
  releasedAt           DateTime?     @map("released_at") @db.Timestamptz(6)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  disputesAsEscrowHold Dispute[]     @relation("disputes_escrow_hold_idToescrow_holds")
  beneficiaryOrg       Organization  @relation(fields: [beneficiaryOrgId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment              Payment       @relation(fields: [paymentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workOrder            WorkOrder?    @relation(fields: [workOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dispute              Dispute?      @relation("escrow_holds_dispute_idTodisputes", fields: [disputeId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_escrow_dispute")
  partOrder            PartOrder?    @relation(fields: [partOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_escrow_part_order")
  payoutItems          PayoutItem[]

  @@index([beneficiaryOrgId, status], map: "idx_escrow_org_status")
  @@map("escrow_holds")
}

model FleetApproval {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String            @map("org_id") @db.Uuid
  workOrderId    String?           @map("work_order_id") @db.Uuid
  partOrderId    String?           @map("part_order_id") @db.Uuid
  versionId      String?           @map("version_id") @db.Uuid
  approverUserId String            @map("approver_user_id") @db.Uuid
  decision       String            @db.VarChar(10)
  noteAr         String?           @map("note_ar")
  decidedAt      DateTime          @default(now()) @map("decided_at") @db.Timestamptz(6)
  approverUser   User              @relation(fields: [approverUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  org            Organization      @relation(fields: [orgId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  partOrder      PartOrder?        @relation(fields: [partOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  version        WorkOrderVersion? @relation(fields: [versionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workOrder      WorkOrder?        @relation(fields: [workOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("fleet_approvals")
}

model FleetPolicy {
  id                        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                     String       @map("org_id") @db.Uuid
  nameAr                    String       @map("name_ar") @db.VarChar(120)
  autoApproveBelow          Decimal      @default(0) @map("auto_approve_below") @db.Decimal(14, 2)
  requiresTwoApproversAbove Decimal?     @map("requires_two_approvers_above") @db.Decimal(14, 2)
  allowedOrgIds             String[]     @map("allowed_org_ids") @db.Uuid
  monthlyBudget             Decimal?     @map("monthly_budget") @db.Decimal(14, 2)
  isActive                  Boolean      @default(true) @map("is_active")
  createdAt                 DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  org                       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("fleet_policies")
}

model FleetStatement {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String         @map("org_id") @db.Uuid
  periodStart DateTime       @map("period_start") @db.Date
  periodEnd   DateTime       @map("period_end") @db.Date
  total       Decimal        @db.Decimal(14, 2)
  invoiceIds  String[]       @map("invoice_ids") @db.Uuid
  pdfMediaId  String?        @map("pdf_media_id") @db.Uuid
  status      invoice_status @default(issued)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  org         Organization   @relation(fields: [orgId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pdfMedia    MediaAsset?    @relation(fields: [pdfMediaId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([orgId, periodStart, periodEnd])
  @@map("fleet_statements")
}

model GroupBuy {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number         String       @unique @db.VarChar(24)
  supplierOrgId  String       @map("supplier_org_id") @db.Uuid
  catalogId      String       @map("catalog_id") @db.Uuid
  industrialZone String?      @map("industrial_zone") @db.VarChar(120)
  unitPrice      Decimal      @map("unit_price") @db.Decimal(14, 2)
  minQuantity    Int          @map("min_quantity")
  committedQty   Int          @default(0) @map("committed_qty")
  closesAt       DateTime     @map("closes_at") @db.Timestamptz(6)
  status         String       @default("open") @db.VarChar(20)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  catalog        PartsCatalog @relation(fields: [catalogId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supplierOrg    Organization @relation(fields: [supplierOrgId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  partOrders     PartOrder[]

  @@map("group_buys")
}

model Inspection {
  id                     String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workOrderId            String?             @map("work_order_id") @db.Uuid
  vehicleId              String              @map("vehicle_id") @db.Uuid
  orgId                  String?             @map("org_id") @db.Uuid
  type                   inspection_type
  odometerKm             Int?                @map("odometer_km")
  fuelLevelPct           Int?                @map("fuel_level_pct") @db.SmallInt
  checklist              Json                @default("{}")
  damages                Json                @default("[]")
  aiSummary              Json?               @map("ai_summary")
  inspectorUserId        String?             @map("inspector_user_id") @db.Uuid
  customerAckSignatureId String?             @map("customer_ack_signature_id") @db.Uuid
  performedAt            DateTime            @default(now()) @map("performed_at") @db.Timestamptz(6)
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  customerAckSignature   WorkOrderSignature? @relation(fields: [customerAckSignatureId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inspectorUser          User?               @relation(fields: [inspectorUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  org                    Organization?       @relation(fields: [orgId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vehicle                Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workOrder              WorkOrder?          @relation(fields: [workOrderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([workOrderId], map: "idx_inspections_wo")
  @@map("inspections")
}

model IntegrationCredential {
  id        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider  integration_provider
  orgId     String?              @map("org_id") @db.Uuid
  secretEnc Bytes                @map("secret_enc")
  metadata  Json                 @default("{}")
  expiresAt DateTime?            @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  org       Organization?        @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider, orgId])
  @@map("integration_credentials")
}

model IntegrationRequest {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider        integration_provider
  operation       String               @db.VarChar(60)
  idempotencyKey  String               @unique @map("idempotency_key") @db.VarChar(160)
  refTable        String?              @map("ref_table") @db.VarChar(40)
  refId           String?              @map("ref_id") @db.Uuid
  status          integration_status   @default(pending)
  attempts        Int                  @default(0) @db.SmallInt
  nextAttemptAt   DateTime?            @map("next_attempt_at") @db.Timestamptz(6)
  requestPayload  Json?                @map("request_payload")
  responsePayload Json?                @map("response_payload")
  httpStatus      Int?                 @map("http_status")
  errorMessage    String?              @map("error_message")
  latencyMs       Int?                 @map("latency_ms")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([refTable, refId], map: "idx_integration_requests_ref")
  @@map("integration_requests")
}

model InventorySyncRun {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String       @map("org_id") @db.Uuid
  source       String       @db.VarChar(20)
  fileMediaId  String?      @map("file_media_id") @db.Uuid
  rowsTotal    Int?         @map("rows_total")
  rowsUpserted Int?         @map("rows_upserted")
  rowsFailed   Int?         @map("rows_failed")
  errors       Json?
  startedAt    DateTime     @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt   DateTime?    @map("finished_at") @db.Timestamptz(6)
  fileMedia    MediaAsset?  @relation(fields: [fileMediaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("inventory_sync_runs")
}

model InvoiceLine {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId       String         @map("invoice_id") @db.Uuid
  workOrderItemId String?        @map("work_order_item_id") @db.Uuid
  descriptionAr   String         @map("description_ar")
  descriptionEn   String?        @map("description_en")
  quantity        Decimal        @db.Decimal(10, 2)
  unitPrice       Decimal        @map("unit_price") @db.Decimal(14, 2)
  discount        Decimal        @default(0) @db.Decimal(14, 2)
  vatRate         Decimal        @default(15.00) @map("vat_rate") @db.Decimal(5, 2)
  vatAmount       Decimal        @map("vat_amount") @db.Decimal(14, 2)
  lineTotal       Decimal        @map("line_total") @db.Decimal(14, 2)
  sortOrder       Int            @default(0) @map("sort_order")
  invoice         Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workOrderItem   WorkOrderItem? @relation(fields: [workOrderItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("invoice_lines")
}

model InvoiceSequence {
  orgId      String       @map("org_id") @db.Uuid
  series     String       @default("INV") @db.VarChar(10)
  year       Int          @db.SmallInt
  lastNumber Int          @default(0) @map("last_number")
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([orgId, series, year])
  @@map("invoice_sequences")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Invoice {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId            String            @map("org_id") @db.Uuid
  number           String            @db.VarChar(40)
  type             invoice_type      @default(simplified_tax)
  status           invoice_status    @default(draft)
  workOrderId      String?           @map("work_order_id") @db.Uuid
  partOrderId      String?           @map("part_order_id") @db.Uuid
  transportJobId   String?           @map("transport_job_id") @db.Uuid
  parentInvoiceId  String?           @map("parent_invoice_id") @db.Uuid
  customerUserId   String?           @map("customer_user_id") @db.Uuid
  customerOrgId    String?           @map("customer_org_id") @db.Uuid
  buyerSnapshot    Json              @map("buyer_snapshot")
  sellerSnapshot   Json              @map("seller_snapshot")
  currency         String            @default("SAR") @db.Char(3)
  subtotal         Decimal           @db.Decimal(14, 2)
  discountTotal    Decimal           @default(0) @map("discount_total") @db.Decimal(14, 2)
  vatTotal         Decimal           @map("vat_total") @db.Decimal(14, 2)
  total            Decimal           @db.Decimal(14, 2)
  paidTotal        Decimal           @default(0) @map("paid_total") @db.Decimal(14, 2)
  paymentTerms     payment_terms     @map("payment_terms")
  issueDate        DateTime?         @map("issue_date") @db.Timestamptz(6)
  dueDate          DateTime?         @map("due_date") @db.Date
  supplyDate       DateTime?         @map("supply_date") @db.Date
  zatcaUuid        String?           @map("zatca_uuid") @db.Uuid
  zatcaIcv         BigInt?           @map("zatca_icv")
  zatcaPih         String?           @map("zatca_pih")
  zatcaHash        String?           @map("zatca_hash")
  zatcaQr          String?           @map("zatca_qr")
  zatcaStatus      zatca_status      @default(not_required) @map("zatca_status")
  xmlMediaId       String?           @map("xml_media_id") @db.Uuid
  pdfMediaId       String?           @map("pdf_media_id") @db.Uuid
  notesAr          String?           @map("notes_ar")
  voidedAt         DateTime?         @map("voided_at") @db.Timestamptz(6)
  voidReason       String?           @map("void_reason")
  createdBy        String?           @map("created_by") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  zatcaXml         String?           @map("zatca_xml")
