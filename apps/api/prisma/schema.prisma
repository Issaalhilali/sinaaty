  vinSnapshot         String?                @map("vin_snapshot") @db.VarChar(17)
  faultPercent        Decimal?               @map("fault_percent") @db.Decimal(5, 2)
  insurerNameAr       String?                @map("insurer_name_ar") @db.VarChar(120)
  policyNo            String?                @map("policy_no") @db.VarChar(60)
  claimNo             String?                @map("claim_no") @db.VarChar(60)
  deductibleAmount    Decimal?               @map("deductible_amount") @db.Decimal(14, 2)
  approvedAmount      Decimal?               @map("approved_amount") @db.Decimal(14, 2)
  damages             Json                   @default("[]")
  repairSubmissionRef String?                @map("repair_submission_ref") @db.VarChar(80)
  repairSubmittedAt   DateTime?              @map("repair_submitted_at") @db.Timestamptz(6)
  raw                 Json                   @default("{}")
  createdBy           String?                @map("created_by") @db.Uuid
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime               @default(now()) @map("updated_at") @db.Timestamptz(6)
  users               User?                  @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organizations       Organization?          @relation(fields: [orgId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vehicles            Vehicle?               @relation(fields: [vehicleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workOrder           WorkOrder?             @relation(fields: [workOrderId], references: [id], onUpdate: NoAction)

  @@unique([provider, externalRef])
  @@index([vehicleId, accidentAt(sort: Desc)], map: "idx_accident_reports_vehicle")
  @@index([workOrderId], map: "idx_accident_reports_wo")
  @@map("accident_reports")
}

model AdminApproval {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action           String    @db.VarChar(60)
  entityType       String    @map("entity_type") @db.VarChar(40)
  entityId         String    @map("entity_id") @db.Uuid
  payload          Json
  status           String    @default("requested") @db.VarChar(16)
  requestedBy      String    @map("requested_by") @db.Uuid
  requestedAt      DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  decidedBy        String?   @map("decided_by") @db.Uuid
  decidedAt        DateTime? @map("decided_at") @db.Timestamptz(6)
  decisionReasonAr String?   @map("decision_reason_ar")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  decidedByUser    User?     @relation("admin_approvals_decided", fields: [decidedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requestedByUser  User      @relation("admin_approvals_requested", fields: [requestedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("admin_approvals")
}

model AnalyticsEvent {
  id             BigInt        @id @default(autoincrement())
  occurredAt     DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(6)
  event          String        @db.VarChar(60)
  orgId          String?       @map("org_id") @db.Uuid
  actorUserId    String?       @map("actor_user_id") @db.Uuid
  entityType     String?       @map("entity_type") @db.VarChar(40)
  entityId       String?       @map("entity_id") @db.Uuid
  industrialZone String?       @map("industrial_zone") @db.VarChar(120)
  props          Json          @default("{}")
  users          User?         @relation(fields: [actorUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organizations  Organization? @relation(fields: [orgId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([event, entityType, entityId])
  @@index([event, occurredAt(sort: Desc)], map: "idx_analytics_event_time")
  @@index([orgId, occurredAt(sort: Desc)], map: "idx_analytics_org_time")
  @@index([industrialZone, occurredAt(sort: Desc)], map: "idx_analytics_zone_time")
  @@map("analytics_events")
}

