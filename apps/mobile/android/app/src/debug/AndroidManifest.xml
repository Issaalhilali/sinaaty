<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- The dev API is plain HTTP on the LAN, which Android 9+ blocks by default — every request
         dies inside the phone and surfaces as «لا يوجد اتصال بالإنترنت». Debug/profile only:
         release builds keep Android's HTTPS-only default. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
