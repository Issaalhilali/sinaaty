# Flutter/Dart/Pub related (apps/mobile). Root .gitignore covers OS/IDE/env.
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
migrate_working_dir/

# Symbolication / obfuscation
app.*.symbols
app.*.map.json

# Android Studio build artifacts
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# golden-test failure artifacts (debug output, never source)
test/failures/
